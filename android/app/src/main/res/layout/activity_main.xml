<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="一鍵投屏"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvPc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="電腦：未搵到"
            android:textSize="15sp"
            android:layout_marginTop="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCast"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="22dp"
            android:text="一鍵投屏"
            android:textSize="30sp"
            app:backgroundTint="#2E7BE0"
            app:cornerRadius="28dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="（長按大掣 = 停止投屏）"
            android:textSize="12sp"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFind"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                style="?attr/materialButtonOutlinedStyle"
                android:text="重新搵電腦" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                style="?attr/materialButtonOutlinedStyle"
                android:text="停止投屏" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="準備中…"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="12sp"
            android:textColor="#888888"
            android:text="用法：&#10;1. 電腦開住「無線投屏」App（會喺 8765 等手機指令）&#10;2. 手機同電腦連同一個 Wi-Fi&#10;3. 按上面大掣 → 電腦自動開 scrcpy&#10;&#10;亦可以喺下拉快捷面板加「一鍵投屏」磚，一拉一按即投屏。&#10;&#10;第一次可選擇用 adb 授權一次（開機自動開無線偵錯）：&#10;adb shell pm grant tw.hermes.onetapcast android.permission.WRITE_SECURE_SETTINGS" />
    </LinearLayout>
</ScrollView>
